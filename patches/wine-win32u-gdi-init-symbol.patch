+/* ml1319: the body of Wine's gdi_init(), reachable from any handle path. See the note
+ * at gdi_init_lock above for why the whole sequence runs here rather than the table
+ * alone; gdi_ensure_init itself is defined after init_stock_objects(). */
+
 /***********************************************************************
  *           GetStockObject    (win32u.so)
  */
@@ -990,6 +1020,56 @@ static void init_stock_objects( unsigned int dpi )
 }
 
 
+/* ml1319: WHICH ORDER, AND WHY IT IS WINE'S OWN.
+ *
+ * Order matters: the recursive object lock, then the shared table, then font_init()
+ * and the stock objects. A thread that finds state 1 is one of our own stock-object
+ * allocations (gdi_init_lock is recursive, so it holds the lock): the table exists and
+ * the stock objects are being created in order right now, so its request must not
+ * re-enter the body -- it just allocates its handle. A thread that finds state 2 after
+ * waiting is behind a finished initialisation and does the same.
+ *
+ * A failed table allocation goes back to state 0 instead: the next caller retries,
+ * because the failure actually seen (ml1300, load-time) was transient memory pressure,
+ * not a permanent state. */
+static void gdi_ensure_init( void )
+{
+    if (__atomic_load_n( &gdi_init_state, __ATOMIC_ACQUIRE ) == 2) return;
+    pthread_mutex_lock( &gdi_init_lock );
+    if (gdi_init_state)
+    {
+        pthread_mutex_unlock( &gdi_init_lock );
+        return;
+    }
+    gdi_init_state = 1;
+    {
+        pthread_mutexattr_t attr;
+        pthread_mutexattr_init( &attr );
+        pthread_mutexattr_settype( &attr, PTHREAD_MUTEX_RECURSIVE );
+        pthread_mutex_init( &gdi_lock, &attr );
+        pthread_mutexattr_destroy( &attr );
+    }
+    /* ml1319: the body is init_gdi_shared_once(); calling a name that is only
+     * declared left gdiobj.o with an undefined `_init_gdi_shared`, so every
+     * unix-half component was refused by dyld ("symbol not found in flat
+     * namespace") and the linked copy returned with gdi_shared still NULL. */
+    init_gdi_shared_once();
+    if (gdi_shared)
+    {
+        unsigned int dpi = font_init();
+        init_stock_objects( dpi );
+        __atomic_store_n( &gdi_init_state, 2, __ATOMIC_RELEASE );
+    }
+    else
+    {
+        static int said;
+        if (!said++) ERR( "[gdi-null] ml1319: the shared handle table could not be allocated; "
+                          "the next GDI call retries\n" );
+        __atomic_store_n( &gdi_init_state, 0, __ATOMIC_RELEASE );
+    }
+    pthread_mutex_unlock( &gdi_init_lock );
+}
