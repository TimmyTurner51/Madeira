 static const char *gdi_obj_type( unsigned type )
 {
     switch ( type )
@@ -1043,10 +1123,26 @@ HGDIOBJ alloc_gdi_handle( struct gdi_obj_header *obj, DWORD type, const struct g
 
     assert( type );  /* type 0 is reserved to mark free entries */
 
+    /* ml1319: run Wine's own gdi_init() sequence on first use instead of trusting that
+     * init_user() ran. With gdi_shared NULL this function used to fall into the branch
+     * below with entry == NULL (0 < NULL + 0x180000) and store through it -- the
+     * load-time crash in set6.log. ml1314 built only the table here, which shifted the
+     * stock objects and tripped init_stock_objects()'s first-handle assertion; the
+     * stock objects are created first now, so this caller takes a handle after them. */
+    if (!gdi_shared) gdi_ensure_init();
+    if (!gdi_shared)
+    {
+        ERR( "[gdi-null] ml1319: no shared handle table (allocation failed) -- cannot "
+             "allocate type %#x for %p\n", (unsigned)type, obj );
+        return 0;
+    }
+
     win32u_gdi_check_publish();
 
     pthread_mutex_lock( &gdi_lock );
 
+    if (!next_unused) next_unused = gdi_shared->Handles + FIRST_GDI_HANDLE;   /* ml1314 */
+
     entry = next_free;
     if (entry)
         next_free = (GDI_HANDLE_ENTRY *)(UINT_PTR)entry->Object;
@@ -1363,17 +1459,7 @@ BOOL WINAPI NtGdiSetColorAdjustment( HDC hdc, const COLORADJUSTMENT *ca )
 
 void gdi_init(void)
 {
-    pthread_mutexattr_t attr;
-    unsigned int dpi;
-
-    pthread_mutexattr_init( &attr );
-    pthread_mutexattr_settype( &attr, PTHREAD_MUTEX_RECURSIVE );
-    pthread_mutex_init( &gdi_lock, &attr );
-    pthread_mutexattr_destroy( &attr );
-
-    init_gdi_shared();
-    if (!gdi_shared) return;
-
-    dpi = font_init();
-    init_stock_objects( dpi );
+    /* ml1319: the same sequence a load-time handle allocation runs, so whichever
+     * comes first does the work once and the other finds it done. */
+    gdi_ensure_init();
 }
