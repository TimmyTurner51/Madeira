@@ -49,6 +49,28 @@ static GDI_HANDLE_ENTRY *next_free;
 static GDI_HANDLE_ENTRY *next_unused;
 static LONG debug_count;
 
+/* ml1319: ONE initialiser, callable from anywhere, that runs Wine's OWN sequence.
+ *
+ * The table used to be published only by init_user() -> gdi_init(), i.e. from
+ * NtUserInitializeClientPfnArrays. A load-time GDI call can beat that: set6.log has a
+ * comctl32 attach reaching alloc_gdi_handle at 0x1091c6700 with gdi_shared == NULL,
+ * which took the "there is room" branch with entry == NULL and stored through it
+ * (fault_rip cnt=1..4: addr 0x0, then 0x30, 0x48, 0x78 as next_unused crept up 0x18
+ * per retry) and killed the load.
+ *
+ * ml1314 built only the TABLE from the handle path and left the stock objects to
+ * gdi_init(). That is wrong on its own terms: init_stock_objects() asserts that the
+ * stock bitmap lands on FIRST_GDI_HANDLE + DEFAULT_BITMAP, so one handle taken before
+ * it shifts every stock object and the assertion kills the session at load
+ * ("Assertion failed: ... init_stock_objects, file gdiobj.c, line 1006"). The early
+ * caller has to be served AFTER the stock objects exist, which is exactly the order
+ * Wine's own gdi_init() uses -- so the whole sequence runs here, under one state
+ * machine, and gdi_init() is just a call into it. */
+static pthread_mutex_t gdi_init_lock = PTHREAD_RECURSIVE_MUTEX_INITIALIZER;
+static int gdi_init_state;   /* 0 = not started, 1 = running on the caller's thread, 2 = done */
+static void init_gdi_shared_once( void );
+static void gdi_ensure_init( void );
