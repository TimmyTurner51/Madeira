+/* ml1255: "<module path>" for an address, for the [uef] probes. Uses only
+ * APIs this file already calls, so it works before the loader has finished. */
+static const char *uef_where( void *addr, char *buf, size_t buflen )
+{
+    void *module = NULL;
+    WCHAR name[MAX_PATH];
+    DWORD len;
+
+    if (!addr) return "null";
+    RtlPcToFileHeader( addr, &module );
+    if (!module) return "no-module";
+    len = GetModuleFileNameW( module, name, MAX_PATH );
+    if (!len || len >= MAX_PATH) return "?";
+    if (!WideCharToMultiByte( CP_ACP, 0, name, len, buf, buflen, NULL, NULL )) return "?";
+    buf[buflen - 1] = 0;
+    return buf;
+}
