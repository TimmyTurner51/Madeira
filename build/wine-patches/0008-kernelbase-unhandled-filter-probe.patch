 /***********************************************************************
  *           SetUnhandledExceptionFilter   (kernelbase.@)
  */
 LPTOP_LEVEL_EXCEPTION_FILTER WINAPI DECLSPEC_HOTPATCH SetUnhandledExceptionFilter(
     LPTOP_LEVEL_EXCEPTION_FILTER filter )
 {
-    return InterlockedExchangePointer( (void **)&top_filter, filter );
+    LPTOP_LEVEL_EXCEPTION_FILTER prev = InterlockedExchangePointer( (void **)&top_filter, filter );
+
+    /* iOS-Madeira ml1255: name the OTHER registration site.
+     *
+     * [veh-add] watches RtlAddVectoredExceptionHandler, and in the Forza runs it
+     * shows exactly one handler -- the Dr0-Dr7 anti-debug harness. A decrypt-on-
+     * fault filter would not appear there at all, because this is where it would
+     * register: SetUnhandledExceptionFilter, not a vectored handler. So "no
+     * decryptor registered" was only true of one of the two chains, and the
+     * unhandled filter is the one whose verdict the run actually reaches
+     * (UnhandledExceptionFilter is called by the frame walk and declines).
+     *
+     * Logged with the setting module resolved, so the log says whether the game
+     * installs a filter before its first encrypted function runs, and what it
+     * replaced. Capped: a CRT start installs one, but a crash-reporter may
+     * reinstall per thread. */
+    {
+        static LONG set_n;
+        if (InterlockedIncrement( &set_n ) <= 8)
+        {
+            char cbuf[160], fbuf[160];
+
+            /* Who called, and where does the filter itself live? The second is
+             * the one that decides whether the game installed a handler of its
+             * own: a filter inside forzahorizon6.exe is the guest's, one inside
+             * ntdll/kernelbase is Wine's own crash plumbing. */
+            ERR( "[uef] ml1255 set #%ld: filter=%p (%s) replaces %p, called from %s\n",
+                 set_n, (void *)filter, uef_where( (void *)filter, fbuf, sizeof(fbuf) ),
+                 prev, uef_where( __builtin_return_address( 0 ), cbuf, sizeof(cbuf) ) );
+        }
+    }
+    return prev;
 }
 
 
