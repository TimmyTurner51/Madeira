From b838dc06ef732d5ea074f38dcddaa35727b5435a Mon Sep 17 00:00:00 2001
From: Madeira <madeira@example.invalid>
Date: Sun, 15 Nov 2026 01:33:14 -0600
Subject: [PATCH] ntdll: report the GetCommandLineA slot rva and its PE value

The unix-side [x9-probe] computes the slot address as x9+14+rel and
reported 0x153a96e80 (rva 0x46e80) for the kernel32 thunk that ucrtbase's
exit uses, but that thunk's own `ff 25` displacement encodes rva 0x50650
(pool 0x153aa0650). Both cannot be the same slot, and the difference decides
whether the pool copy really kept 0xcc after the sync or the probe simply
read the wrong address.

Capture the name match on every slot rather than only on the resolve path,
which never triggers here because nothing is unbound, and print the slot's
rva together with the value the PE view holds. That is the PE-side truth the
probe can be compared against.

Signed-off-by: Madeira <madeira@example.invalid>
Co-authored-by: Cursor <cursoragent@cursor.com>
---
 dlls/ntdll/loader.c         |  2 +-
 dlls/ntdll/signal_arm64ec.c | 32 ++++++++++++++++++++++++--------
 2 files changed, 25 insertions(+), 9 deletions(-)

diff --git a/dlls/ntdll/loader.c b/dlls/ntdll/loader.c
index 1e678b6a..e97737fc 100644
--- a/dlls/ntdll/loader.c
+++ b/dlls/ntdll/loader.c
@@ -5809,7 +5809,7 @@ void loader_init( CONTEXT *context, void **entry )
         ERR( "loader_init: [iOS] early locale_init done (casemap wired before arm64ec module)\n" );
         /* The suffix identifies THIS ntdll: the deployed PE can be shadowed by
          * the app bundle's copy, and a bare line cannot tell them apart. */
-        ERR( "loader_init: calling load_arm64ec_module [ntdll ml1227 iat-sync v3]\n" );
+        ERR( "loader_init: calling load_arm64ec_module [ntdll ml1228 iat-sync v4]\n" );
         load_arm64ec_module();
         ERR( "loader_init: load_arm64ec_module returned, calling update_load_config\n" );
         update_load_config( wm->ldr.DllBase );
diff --git a/dlls/ntdll/signal_arm64ec.c b/dlls/ntdll/signal_arm64ec.c
index 04416099..1f10c4dc 100644
--- a/dlls/ntdll/signal_arm64ec.c
+++ b/dlls/ntdll/signal_arm64ec.c
@@ -1211,7 +1211,7 @@ ULONG arm64ec_sync_bound_iat_slots(void)
         IMAGE_IMPORT_DESCRIPTOR *desc;
         ULONG mslots = 0, msynced = 0, munbound = 0, mfiller = 0, size;
         int have_gcla = 0;
-        ULONG_PTR gcla = 0;
+        ULONG_PTR gcla = 0, gcla_rva = 0;
 
         if (!module) continue;
         /* Only hybrid images care: a pure x64 importer must keep the x64
@@ -1238,6 +1238,26 @@ ULONG arm64ec_sync_bound_iat_slots(void)
                 void *proc;
 
                 mslots++;
+                /* Record the GetCommandLineA slot whatever happens to it.
+                 * The unix-side [x9-probe] that reads this slot from the pool
+                 * computes its address as x9+14+rel and reported 0x153a96e80
+                 * (rva 0x46e80) for a thunk whose own `ff 25` displacement
+                 * encodes rva 0x50650 (pool 0x153aa0650). Two different slots
+                 * cannot both be right, so log the PE-side truth here: the
+                 * slot's rva and the value the PE view holds. Comparing that
+                 * against the probe tells us whether the pool really kept
+                 * 0xcc, or whether the probe read somewhere else entirely. */
+                if (!IMAGE_SNAP_BY_ORDINAL( ilt->u1.Ordinal ))
+                {
+                    IMAGE_IMPORT_BY_NAME *gn =
+                        get_rva( module, (DWORD)ilt->u1.AddressOfData );
+                    if (!strcmp( (const char *)gn->Name, "GetCommandLineA" ))
+                    {
+                        have_gcla = 1;
+                        gcla = (ULONG_PTR)iat->u1.Function;
+                        gcla_rva = (ULONG_PTR)iat - (ULONG_PTR)module;
+                    }
+                }
                 /* Is the PE view bound? A bound slot holds a VA, and every VA
                  * in this process is above 4 GB: PE images load near
                  * 0x71fe..., the JIT pool near 0x153..., FEX's arena at
@@ -1290,11 +1310,6 @@ ULONG arm64ec_sync_bound_iat_slots(void)
                     if (!proc) continue;
                     if ((pmeta = arm64ec_get_module_metadata( provider )))
                         proc = arm64ec_redirect_ptr( provider, proc, pmeta );
-                    if (!strcmp( (const char *)by_name->Name, "GetCommandLineA" ))
-                    {
-                        have_gcla = 1;
-                        gcla = (ULONG_PTR)proc;
-                    }
                     {
                         void *base = iat;
                         SIZE_T range = sizeof(void *);
@@ -1330,8 +1345,9 @@ ULONG arm64ec_sync_bound_iat_slots(void)
              (unsigned long)(mslots - munbound - mfiller), (unsigned long)munbound,
              (unsigned long)mfiller, (unsigned long)msynced );
         if (have_gcla)
-            ERR( "[iat-sync]   %s GetCommandLineA -> %p\n",
-                 debugstr_w( entry->BaseDllName.Buffer ), (void *)gcla );
+            ERR( "[iat-sync]   %s GetCommandLineA slot rva=%lx pe-value=%p\n",
+                 debugstr_w( entry->BaseDllName.Buffer ),
+                 (unsigned long)gcla_rva, (void *)gcla );
     }
 
     ERR( "[iat-sync] done: %lu hybrid module(s), %lu slot(s), %lu bound, "
-- 
