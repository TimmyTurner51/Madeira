+/* FH6 15:49: after 12 raw syscalls the game VirtualProtect'd ntdll .data
+ * (0x71F3372000+0x2000, PAGE_EXECUTE_READWRITE). FEX treated that as "this
+ * is now x64 code", copied the PE view of the page (on-disk zeros) over the
+ * pool copy ARM64 ntdll actually reads, and wiped pBeginSimulation at
+ * rva 0xd2ea0. The next dispatch_emulation did ldr x11,[ntdll+0xd2ea0];
+ * blr check_call with x11=0. The protect itself is honest (Denuvo is
+ * allowed to change ntdll's protection); the FEX notify is not, because
+ * this is data with live function pointers, not a code page. */
+static BOOL ios_data_exec_suppressed( const char *via, void *addr, SIZE_T size, ULONG prot )
+{
+    static int said;
+    LDR_DATA_TABLE_ENTRY *mod;
+    IMAGE_NT_HEADERS *nt;
+    const IMAGE_SECTION_HEADER *sec;
+    DWORD i;
+    ULONG_PTR rva;
+    const ULONG exec_mask = PAGE_EXECUTE | PAGE_EXECUTE_READ |
+                            PAGE_EXECUTE_READWRITE | PAGE_EXECUTE_WRITECOPY;
+
+    if (!(prot & exec_mask)) return FALSE;
+    if (LdrFindEntryForAddress( addr, &mod ) || !mod || !mod->DllBase) return FALSE;
+    nt = RtlImageNtHeader( mod->DllBase );
+    if (!nt) return FALSE;
+    rva = (ULONG_PTR)addr - (ULONG_PTR)mod->DllBase;
+    sec = IMAGE_FIRST_SECTION( nt );
+    for (i = 0; i < nt->FileHeader.NumberOfSections; i++, sec++)
+    {
+        ULONG_PTR start = sec->VirtualAddress;
+        ULONG_PTR end = start + sec->Misc.VirtualSize;
+        if (rva < start || rva >= end) continue;
+        if (sec->Characteristics & (IMAGE_SCN_CNT_CODE | IMAGE_SCN_MEM_EXECUTE))
+            return FALSE;
+        if (said < 16)
+        {
+            said++;
+            ERR( "[exec-data] SUPPRESSED via=%s %p+%p prot=%lx module=%s rva=%lx "
+                 "chars=%lx (PE data, not code; FEX copy would clobber live ARM64 .data)\n",
+                 via, addr, (void *)size, (unsigned long)prot,
+                 debugstr_w( mod->BaseDllName.Buffer ), (unsigned long)rva,
+                 (unsigned long)sec->Characteristics );
+        }
+        return TRUE;
+    }
+    return FALSE;
+}
+
+static BOOL ios_protect_notify_suppressed( const char *via, void *addr, SIZE_T size, ULONG prot )
+{
+    return ios_bulk_protect_suppressed( via, addr, size, prot )
+        || ios_data_exec_suppressed( via, addr, size, prot );
+}
