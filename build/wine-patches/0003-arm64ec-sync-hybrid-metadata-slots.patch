diff --git a/dlls/ntdll/signal_arm64ec.c b/dlls/ntdll/signal_arm64ec.c
index 9ed09f7e..430501d8 100644
--- a/dlls/ntdll/signal_arm64ec.c
+++ b/dlls/ntdll/signal_arm64ec.c
@@ -965,7 +965,31 @@ static void update_hybrid_pointer( void *module, const IMAGE_SECTION_HEADER *sec
         ERR( "rva %x outside of section %s (%lx-%lx)\n", rva,
              sec->Name, sec->VirtualAddress, sec->VirtualAddress + sec->Misc.VirtualSize );
     else
-        *(void **)get_rva( module, rva ) = ptr;
+    {
+        void *dest = get_rva( module, rva );
+
+        *(void **)dest = ptr;
+        /* The guest executes the pool copy of this image, and nothing syncs a
+         * plain PE store into it. ucrtbase's
+         * __os_arm64x_dispatch_call_no_redirect (rva e3898) therefore stayed 0
+         * in the copy the code reads, so its exception dispatch did
+         * `adrp x8,page; ldr x16,[x8,#0x898]; blr x16` -> pc=0, lr=0x90f1c.
+         * Push the store through the same verified unix call the loader uses
+         * for its TLS index. */
+        {
+            struct ios_sync_pe_write_params params = { dest, sizeof(void *), 0 };
+            static int said;
+            NTSTATUS sync = __wine_unixlib_handle
+                ? WINE_UNIX_CALL( unix_ios_sync_pe_write, &params )
+                : STATUS_PROCEDURE_NOT_FOUND;   /* too early: no unix side yet */
+            if (said++ < 32)
+                ERR( "hybrid-slot rva=%x <- %p sync=%lx copied=%lu\n",
+                     rva, ptr, sync, params.synced );
+            /* A failure here leaves the pool copy stale (the old bug), which is
+             * no worse than before, so report it and carry on rather than take
+             * the process down for a diagnostic slot. */
+        }
+    }
 }
 
 /*******************************************************************
@@ -980,6 +1004,15 @@ void arm64ec_update_hybrid_metadata( void *module, IMAGE_NT_HEADERS *nt,
     /* assume that all pointers are in the same section */
     ERR( "arm64ec_update_hybrid_metadata: module=%p dispatch_call_rva=%lx check_call=%p\n",
          module, (unsigned long)metadata->__os_arm64x_dispatch_call, arm64x_check_call );
+    /* The dispatcher globals must be non-NULL before they are written into a
+     * slot: a NULL here becomes `blr x16` -> pc=0 in every module that gets
+     * this metadata (build 15 died at ucrtbase+0x90f18 exactly that way). */
+    if (!__os_arm64x_dispatch_call_no_redirect || !__os_arm64x_dispatch_fptr ||
+        !__os_arm64x_dispatch_ret)
+        ERR( "arm64ec_update_hybrid_metadata: NULL dispatcher global(s) "
+             "ExitToX64=%p DispatchJump=%p RetToEntryThunk=%p\n",
+             __os_arm64x_dispatch_call_no_redirect, __os_arm64x_dispatch_fptr,
+             __os_arm64x_dispatch_ret );
 
     for (i = 0; i < nt->FileHeader.NumberOfSections; i++, sec++)
     {
@@ -4921,12 +4954,38 @@ static void __attribute__((naked)) arm64x_check_call(void)
          ".Ljmp:\n\t"
          "ldrb w16, [x11]\n\t"
          "cmp w16, #0xff\n\t"
-         "b.ne .Lexit\n\t"
+         "b.ne .Lhotpatch\n\t"
          "ldrb w16, [x11, #1]\n\t"
          "cmp w16, #0x25\n\t"               /* ff 25 jmp *xxx(%rip) */
          "b.ne .Lexit\n\t"
          "ldr w9, [x11, #2]\n\t"
          "add x16, x11, #6\n\t"             /* address after jump */
+         "b .Lfollow\n\t"
+         /* iOS-Madeira: Wine's x64 import thunks now carry the 8-byte hotpatch prologue
+          * that native Windows and x86_64 Wine emit (48 8d a4 24 00 00 00 00) ahead of
+          * the same ff 25 (build/wine-patches/0001). Forza Horizon 6's anti-tamper
+          * requires that prologue, so the bare-thunk test above no longer matches them.
+          * Without this, every such call falls to .Lexit -- "not a special sequence" --
+          * and is routed to the x64 exit thunk, which enters the JIT with no
+          * CpuStateFrame (x28 == 0) and faults at pc 0. Accept the hotpatched form and
+          * follow it exactly as the bare one: TlsAlloc from ucrtbase's exit thunk was
+          * the first to hit this. */
+         ".Lhotpatch:\n\t"
+         "ldr w16, [x11]\n\t"               /* 48 8d a4 24 */
+         "ldr w17, .Lhotpatch_seq\n\t"
+         "cmp w16, w17\n\t"
+         "b.ne .Lexit\n\t"
+         "ldr w16, [x11, #4]\n\t"           /* 00 00 00 00 padding */
+         "cbnz w16, .Lexit\n\t"
+         "ldrb w16, [x11, #8]\n\t"
+         "cmp w16, #0xff\n\t"
+         "b.ne .Lexit\n\t"
+         "ldrb w16, [x11, #9]\n\t"
+         "cmp w16, #0x25\n\t"               /* ff 25 jmp *xxx(%rip) */
+         "b.ne .Lexit\n\t"
+         "ldr w9, [x11, #10]\n\t"
+         "add x16, x11, #14\n\t"            /* address after the hotpatched jump */
+         ".Lfollow:\n\t"
          "ldr x11, [x16, w9, sxtw]\n\t"
          "b \"#arm64x_check_call\"\n"       /* restart checks with jump destination */
          /* not a special sequence, call the exit thunk */
@@ -4945,6 +5004,10 @@ static void __attribute__((naked)) arm64x_check_call(void)
          ".byte 0xe9\n\t"                   /* jmp  arm_code */
          ".byte 0, 0, 0, 0, 0, 0\n"
 
+         /* First word of the hotpatched import thunk (48 8d a4 24 = lea rsp,[rsp+0]). */
+         ".Lhotpatch_seq:\n\t"
+         ".word 0x24a48d48\n\t"
+
          ".Lsyscall_seq:\n\t"
          ".byte 0x4c, 0x8b, 0xd1\n\t"       /* mov  %rcx,%r10 */
          ".byte 0xb8, 0, 0, 0, 0\n\t"       /* mov  $xxx,%eax */
diff --git a/dlls/ntdll/unixlib.h b/dlls/ntdll/unixlib.h
index 6641dddb..251446ee 100644
--- a/dlls/ntdll/unixlib.h
+++ b/dlls/ntdll/unixlib.h
@@ -140,7 +140,7 @@ struct ios_get_fex_arena_params
 struct ios_sync_pe_write_params
 {
     void *address;       /* IN: address in the original PE image */
-    ULONG size;          /* IN: bounded to a single DWORD for TLS indices */
+    ULONG size;          /* IN: 4 for TLS indices, 8 for pointer slots */
     ULONG synced;        /* OUT: 1 if a JIT-pool copy existed and was updated */
 };
 
