+/**************************************************************************
+ *		arm64x_no_redirect_target
+ *
+ * Returns the address to tail-call for __os_arm64x_dispatch_call_no_redirect,
+ * or 0 when the target is not native EC code. See the shim below for why this
+ * does not go through arm64x_check_call.
+ */
+static ULONG_PTR arm64x_no_redirect_target( ULONG_PTR target )
+{
+    static int warned;
+
+    if (RtlIsEcCode( target )) return target;
+
+    /* Not EC code: these are exit thunks, so reaching here means the callee
+     * really is x64 and has to enter FEX emulation. This port has no
+     * EC-callable emulation entry (xtajit64's ExitToX64 is x64 .text and is
+     * exported @extern, so winebuild generates no .hexpthk stub for it), and
+     * inventing one blind would be guesswork. Return without calling and make
+     * the case loud rather than looping through the thunk forever. */
+    if (warned++ < 32)
+        ERR( "arm64x_dispatch_call_no_redirect: target %p is not EC code, "
+             "no native emulation entry available\n", (void *)target );
+    return 0;
+}
+
+
+/**************************************************************************
+ *		arm64x_dispatch_call_no_redirect
+ *
+ * Value for __os_arm64x_dispatch_call_no_redirect, the slot ucrtbase's
+ * $iexit_thunk$cdecl$* blocks branch through:
+ *
+ *     adrp x8, page ; ldr x16,[x8,#0x898] ; blr x16 ; mov x0, x8
+ *
+ * Those thunks set no x10/x11, and the crash registers suggest the callee
+ * arrives in x9 (build 15: x9=0x153a85a70 = ucrtbase's pool copy +0xd9a70,
+ * which lands just past .rdata rather than in .text, so the value still needs
+ * confirming from the log; x10=x11=0x1539acf04 = the thunk's own start).
+ *
+ * Do NOT delegate the classification to arm64x_check_call: that function has
+ * its own inline bitmap reader that reads the PEB through x18, which iOS
+ * clobbers, so it reports every target as non-EC by design (ml246) and would
+ * send us down .Lexit -- for these thunks x10 is the thunk's own address, so
+ * the result is an infinite loop. arm64x_no_redirect_target() instead uses
+ * RtlIsEcCode, which is the C reader and also resolves JIT-pool aliases.
+ *
+ * x0-x8 are saved across the classifier so the call's arguments and the x8 the
+ * thunk relays into x0 both survive. */
+static void __attribute__((naked)) arm64x_dispatch_call_no_redirect(void)
+{
+    asm( ".seh_proc \"#arm64x_dispatch_call_no_redirect\"\n\t"
+         ".seh_endprologue\n\t"
+         "cbz x9, 2f\n\t"                   /* no target: nothing to call */
+         "stp x29, x30, [sp, #-0x60]!\n\t"
+         "stp x0, x1, [sp, #0x10]\n\t"
+         "stp x2, x3, [sp, #0x20]\n\t"
+         "stp x4, x5, [sp, #0x30]\n\t"
+         "stp x6, x7, [sp, #0x40]\n\t"
+         "str x8, [sp, #0x50]\n\t"
+         "mov x0, x9\n\t"
+         "adrp x16, p_arm64x_no_redirect_target\n\t"
+         "ldr x16, [x16, #:lo12:p_arm64x_no_redirect_target]\n\t"
+         "cbz x16, 2f\n\t"
+         "blr x16\n\t"
+         "mov x16, x0\n\t"                  /* resolved target, 0 = not EC code */
+         "ldp x0, x1, [sp, #0x10]\n\t"
+         "ldp x2, x3, [sp, #0x20]\n\t"
+         "ldp x4, x5, [sp, #0x30]\n\t"
+         "ldp x6, x7, [sp, #0x40]\n\t"
+         "ldr x8, [sp, #0x50]\n\t"
+         "ldp x29, x30, [sp], #0x60\n\t"
+         "cbz x16, 2f\n\t"
+         "br x16\n\t"                       /* tail call: x30 is our caller */
+         "2:\tret\n\t"
+         ".seh_endproc" );
+}
+
