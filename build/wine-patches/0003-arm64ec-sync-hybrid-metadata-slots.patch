+static BOOLEAN is_ec_va( const UINT64 *map, ULONG_PTR ptr )
+{
+    ULONG_PTR page;
+
+    if (!ptr || ptr >= ec_code_map_limit()) return FALSE;
+    page = ptr / page_size;
+    return (map[page / 64] >> (page & 63)) & 1;
+}
+
 BOOLEAN WINAPI RtlIsEcCode( ULONG_PTR ptr )
 {
     const UINT64 *map = (const UINT64 *)NtCurrentTeb()->Peb->EcCodeBitMap;
-    ULONG_PTR page = ptr / page_size;
+    ULONG_PTR pe;
     /* The EcCodeBitMap covers only what alloc_arm64ec_map actually reserved. Querying
        any pointer beyond that — a legal Windows address above our VA, or a corrupted
        one from a damaged unwind context — must not segfault. */
-    if (!map || ptr >= ec_code_map_limit()) return FALSE;
-    return (map[page / 64] >> (page & 63)) & 1;
+    if (!map) return FALSE;
+    if (is_ec_va( map, ptr )) return TRUE;
+
+    /* ml704: ARM64EC code runs from the JIT-pool alias of a PE image, and the bitmap
+       is keyed by PE VA, so a pool alias classified as plain x64 code. That is not
+       academic: $iexit_thunk$cdecl$* hands ucrtbase's own pool address to
+       __os_arm64x_dispatch_call_no_redirect in x9 (build 15: 0x153a85a70 =
+       ucrtbase_pool+0xd9a70, just past .rdata -- so the log, not the address,
+       has to say whether that really is a thunk target), and arm64x_check_call
+       would route a native EC builtin
+       into FEX emulation, which branches to null. Resolve registered aliases back to
+       their PE address before giving up. Only the FALSE path pays for this. */
+    {
+        extern void *xlate_ios_jit_rev( void *ptr );
+
+        pe = (ULONG_PTR)xlate_ios_jit_rev( (void *)ptr );
+        if (!pe || pe == ptr) return FALSE;
+        return is_ec_va( map, pe );
+    }
 }
 
 
