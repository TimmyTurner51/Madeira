+  b.eq \fail                      // walked everything: not a known pool address
+  sub \b, \b, #32
+  ldr \c, [\b, #8]                // Entry.JitBase
+  sub \c, \reg, \c                // offset (wraps when \reg < JitBase)
+  ldr \d, [\b, #16]               // Entry.Size
+  cmp \c, \d
+  b.hs 98b
+  ldr \d, [\b]                    // Entry.PeBase
+  add \reg, \d, \c                // PE address of the same byte
