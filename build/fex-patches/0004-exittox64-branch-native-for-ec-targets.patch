diff --git a/Source/Windows/ARM64EC/Module.S b/Source/Windows/ARM64EC/Module.S
--- a/Source/Windows/ARM64EC/Module.S
+++ b/Source/Windows/ARM64EC/Module.S
@@ -208,11 +208,11 @@
   movk x17, #0x5889, lsl #32
   movk x17, #0x5520, lsl #48
   cmp x16, x17
-  b.ne ios_ffs_no_bypass
+  b.ne ios_ec_entry
   ldrh w16, [x9, #8]
   movz w17, #0xe95d
   cmp w16, w17
-  b.ne ios_ffs_no_bypass
+  b.ne ios_ec_entry
   ldursw x16, [x9, #10]  // jmp rel32 (signed)
   add x17, x9, x16
   add x17, x17, #14      // raw target = FFS base + 14 + rel32
@@ -285,6 +285,56 @@
   add x23, x23, #1
   str x23, [x16, #16]    // [2] = matched-but-rejected count
   str x17, [x16, #24]    // [3] = last rejected (PE-space) target
+// ml7xx: x9 matched NO x64 thunk shape, so it is a raw target address.
+//
+// Every test above treats x9 as an x86 import thunk, because that is what wine's
+// builtins hand this dispatcher and decoding it is what made TlsAlloc work. But
+// clang also emits $iexit_thunk$cdecl$* blocks whose x9 is an ARM64EC callee:
+//
+//     adrp x8, page ; ldr x16,[x8,#0x898] ; blr x16 ; mov x0, x8
+//
+// (all four in ucrtbase are byte-identical and share that one slot, so the
+// per-call callee cannot be the slot value -- it is x9). Build 15's log shows
+// exactly that: slot 0xe3898 = 0x1536154e4 = xtajit64 pool 0x1534fd000 + ExitToX64
+// 0x1184e4, i.e. correct; x9 = 0x153a85a70, in the pool but past every module on
+// the stack; x10 = x11 = the thunk's own start.
+//
+// Such a target fails every thunk test and falls to ios_ffs_no_bypass, where
+// enter_jit runs `ldr x16,[x17,#0x40]; br x16` against an all-zero CPU area --
+// no thread has a CpuStateFrame yet during the DllMain walk -- and branches to
+// NULL. That is the c0000005 at pc=0 whose lr is ucrtbase.dll+0x90f1c, the
+// `mov x0,x8` after the blr.
+//
+// So if the EC bitmap says the raw target is ARM64EC code, branch to it
+// natively. This is the same test and the same 0x40000 pool bound that
+// ios_thunk_slot applies to a resolved target -- the test that already makes the
+// TlsAlloc exit thunk work -- and it is only reached once the thunk shapes have
+// been ruled out, so it cannot mistake an x64 thunk for EC code. x4 (x64 R10)
+// and x23 are callee-saved, so both are spilled across it.
+ios_ec_entry:
+  stp x4, x23, [sp, #-16]!       // keep sp 16-aligned; x4=x64 R10
+  lsr x4, x9, #15                // (addr >> 12) / 8 == addr >> 15
+  cmp x4, #0x40000               // 256 KB of bitmap covers 8 GB of pool
+  b.hs ios_ec_entry_miss         // not pool space: cannot be EC code
+  IOS_LOAD_TEB x16
+  ldr x16, [x16, #0x60]          // TEB->PEB
+  ldr x16, [x16, #0x368]         // PEB->EcCodeBitMap
+  cbz x16, ios_ec_entry_miss
+  lsr x4, x9, #18                // word index
+  ldr x16, [x16, x4, lsl #3]
+  lsr x4, x9, #12                // LSRV uses bits[5:0] == the page's bit index
+  lsr x16, x16, x4
+  tbz x16, #0, ios_ec_entry_miss
+  adrp x16, IosFfsBypassLog
+  add x16, x16, #:lo12:IosFfsBypassLog
+  ldr x23, [x16, #32]
+  add x23, x23, #1
+  str x23, [x16, #32]            // [4] = raw-target EC entries taken natively
+  str x9, [x16, #40]             // [5] = last such target
+  ldp x4, x23, [sp], #16
+  br x9                          // native ARM64EC: x0-x8 and lr untouched
+ios_ec_entry_miss:
+  ldp x4, x23, [sp], #16
 ios_ffs_no_bypass:
   IOS_XP_COUNT 2112, x16, x17   // ml1131: EC->x64 call (callback) emulated
 #endif
diff --git a/Source/Windows/ARM64EC/Module.cpp b/Source/Windows/ARM64EC/Module.cpp
--- a/Source/Windows/ARM64EC/Module.cpp
+++ b/Source/Windows/ARM64EC/Module.cpp
@@ -88,7 +88,7 @@
  * [0] = native short-circuits taken, [1] = last EC target,
  * [2] = FFS matched but target not EC (fell through to emulation), [3] = last such
  * target. Read by the [ffs-bypass] reporter in Core.cpp's CompileBlock. */
-extern "C" uint64_t IosFfsBypassLog[4];
+extern "C" uint64_t IosFfsBypassLog[6];
 /* Defined in FEXCore Arm64Emitter.cpp; read when the dispatcher and blocks are emitted. */
 extern "C" uint32_t IosEcReturnWithRet;
 
@@ -101,7 +101,7 @@
 /* uint32_t, not bool: a 1-byte global here misaligned the adrp/ldr pair
  * lld generates for the neighbouring word ("misaligned ldr/str offset"). */
 static uint32_t IosTebTsdImportFound = 0;
-uint64_t IosFfsBypassLog[4] {};
+uint64_t IosFfsBypassLog[6] {};
 /* ml1131: transition probe, written by Module.S and read by wine's ntdll-unix
  * sampler through this DATA export (libarm64ecfex_ios.def). Layout in bytes:
  *   0     magic 'MADXPFEX' (set in ProcessInit)
